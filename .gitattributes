# Normalize line endings to avoid CRLF/LF churn and stabilize Linux CI.
# Keep text files in LF while preserving binary assets as-is.

# --- PowerShell scripts: keep LF in repo for Linux CI consistency ---
*.ps1 text eol=lf
*.psm1 text eol=lf
*.psd1 text eol=lf

# --- Shell scripts (if any) ---
*.sh text eol=lf

# --- Texty configs/docs (safe defaults) ---
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf

# --- Binary (never normalize) ---
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.zip binary
*.rar binary
